# Copy this file to .env and fill in your API keys.
# NEVER commit .env — it is in .gitignore.

# ── Required ──────────────────────────────────────────────────────────────────
# Google Gemini (free tier at https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# ── Optional: AI provider fallback chain ──────────────────────────────────────
# Groq free cloud (fastest — https://console.groq.com)
GROQ_API_KEY=

# NVIDIA NIM (free tier — https://build.nvidia.com)
NVIDIA_API_KEY=

